<Window x:Class="OpenLink.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenLink Settings"
        Height="560"
        Width="720"
        MinHeight="500"
        MinWidth="640"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Settings"
                   FontSize="24"
                   FontWeight="SemiBold"
                   Margin="0,0,0,14"
                   AutomationProperties.Name="OpenLink Settings" />

        <TabControl Grid.Row="1"
                    x:Name="SettingsTabs"
                    AutomationProperties.Name="Settings categories">
            <TabItem Header="Connection">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Label x:Name="DefaultServerLabel"
                               Grid.Row="0"
                               Grid.Column="0"
                               Content="Default server"
                               Target="{Binding ElementName=DefaultServerBox}" />
                        <ComboBox x:Name="DefaultServerBox"
                                  Grid.Row="0"
                                  Grid.Column="1"
                                  Margin="0,0,0,10"
                                  IsEditable="False"
                                  AutomationProperties.LabeledBy="{Binding ElementName=DefaultServerLabel}">
                            <ComboBoxItem Content="https://openlink.tappedin.fm" />
                            <ComboBoxItem Content="https://openlink.raywonderis.me" />
                            <ComboBoxItem Content="https://openlink.devinecreations.net" />
                            <ComboBoxItem Content="https://openlink.devine-creations.com" />
                        </ComboBox>

                        <Label x:Name="SessionPrefixLabel"
                               Grid.Row="1"
                               Grid.Column="0"
                               Content="Session prefix"
                               Target="{Binding ElementName=SessionPrefixBox}" />
                        <TextBox x:Name="SessionPrefixBox"
                                 Grid.Row="1"
                                 Grid.Column="1"
                                 Margin="0,0,0,10"
                                 AutomationProperties.LabeledBy="{Binding ElementName=SessionPrefixLabel}" />

                        <CheckBox x:Name="StartHostingOnLaunchBox"
                                  Grid.Row="2"
                                  Grid.Column="1"
                                  Margin="0,0,0,8"
                                  Content="Start hosting when OpenLink opens" />
                        <CheckBox x:Name="CopyLinkWhenHostingStartsBox"
                                  Grid.Row="3"
                                  Grid.Column="1"
                                  Margin="0,0,0,8"
                                  Content="Copy hosting link when hosting starts" />
                        <CheckBox x:Name="MinimizeToTrayOnCloseBox"
                                  Grid.Row="4"
                                  Grid.Column="1"
                                  Margin="0,0,0,8"
                                  Content="Minimize to tray when closing" />
                        <CheckBox x:Name="LaunchAtLoginBox"
                                  Grid.Row="5"
                                  Grid.Column="1"
                                  Margin="0,0,0,8"
                                  Content="Start OpenLink at sign-in and keep it active when available" />
                        <CheckBox x:Name="StartMinimizedToTrayOnLaunchBox"
                                  Grid.Row="6"
                                  Grid.Column="1"
                                  Margin="0,0,0,8"
                                  Content="Start minimized to the system tray" />
                        <CheckBox x:Name="AutoReconnectOnLaunchBox"
                                  Grid.Row="7"
                                  Grid.Column="1"
                                  Margin="0,0,0,8"
                                  Content="Auto-reconnect trusted machines when launched" />
                        <CheckBox x:Name="AutoStartInteractionOnConnectBox"
                                  Grid.Row="8"
                                  Grid.Column="1"
                                  Content="Start using a device immediately after connecting" />
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Permissions">
                <StackPanel Margin="14">
                    <CheckBox x:Name="AllowRemoteControlBox"
                              Margin="0,0,0,8"
                              Content="Allow remote control after approval" />
                    <CheckBox x:Name="AllowClipboardSyncBox"
                              Margin="0,0,0,8"
                              Content="Allow clipboard sync" />
                    <CheckBox x:Name="AllowFileTransferBox"
                              Margin="0,0,0,8"
                              Content="Allow file transfer" />
                    <CheckBox x:Name="AllowAudioBox"
                              Margin="0,0,0,8"
                              Content="Allow remote audio" />
                    <CheckBox x:Name="AllowDropInAccessBox"
                              Margin="0,0,0,8"
                              Content="Allow trusted machines to drop in" />
                    <CheckBox x:Name="AllowSwapControlBox"
                              Margin="0,0,0,8"
                              Content="Allow swap control with trusted machines" />
                    <CheckBox x:Name="AllowKeyboardCoUseBox"
                              Margin="0,0,0,8"
                              Content="Allow both keyboards while sharing control" />
                    <CheckBox x:Name="CtrlAltDeleteGuardEnabledBox"
                              Margin="0,0,0,8"
                              Content="Guard Control Alt Delete during remote control" />
                    <Label Content="Control Alt Delete action for controlled machine" />
                    <ComboBox x:Name="CtrlAltDeleteRemotePressCountBox"
                              Margin="0,0,0,8"
                              AutomationProperties.Name="Control Alt Delete action for controlled machine">
                        <ComboBoxItem Content="Second press sends Lock to controlled machine" Tag="2" />
                        <ComboBoxItem Content="First press sends Lock to controlled machine" Tag="1" />
                        <ComboBoxItem Content="Third press sends Lock to controlled machine" Tag="3" />
                    </ComboBox>
                    <Label Content="Control Alt Delete action for local Windows lock screen" />
                    <ComboBox x:Name="CtrlAltDeleteLocalLockPressCountBox"
                              Margin="0,0,0,8"
                              AutomationProperties.Name="Control Alt Delete action for local Windows lock screen">
                        <ComboBoxItem Content="Third press locks local Windows" Tag="3" />
                        <ComboBoxItem Content="Second press locks local Windows" Tag="2" />
                        <ComboBoxItem Content="Fourth press locks local Windows" Tag="4" />
                    </ComboBox>
                    <Label Content="After local Windows unlock" />
                    <ComboBox x:Name="CtrlAltDeleteUnlockActionBox"
                              Margin="0,0,0,8"
                              AutomationProperties.Name="After local Windows unlock">
                        <ComboBoxItem Content="Return to controlled device" Tag="return-to-remote" />
                        <ComboBoxItem Content="Stay connected in background" Tag="stay-connected-background" />
                        <ComboBoxItem Content="Disconnect remote session" Tag="disconnect" />
                    </ComboBox>
                    <CheckBox x:Name="AutoConnectTrustedMachinesBox"
                              Margin="0,0,0,8"
                              Content="Auto-connect trusted machines" />
                    <CheckBox x:Name="AllowRemoteApplicationLaunchBox"
                              Margin="0,0,0,8"
                              Content="Allow trusted machines to list, focus, quit, and relaunch apps" />
                    <CheckBox x:Name="AllowRemoteSettingsManagementBox"
                              Margin="0,0,0,8"
                              Content="Allow remote settings management" />
                    <CheckBox x:Name="AllowTrustedOwnerRemoteSettingsChangesBox"
                              Margin="0,0,0,8"
                              Content="Trusted or owned devices can open settings quietly" />
                    <CheckBox x:Name="RequireApprovalForGuestRemoteSettingsChangesBox"
                              Margin="0,0,0,8"
                              Content="Guest settings requests require local approval" />
                    <CheckBox x:Name="LockLocalSettingsDuringRemoteOwnerSessionBox"
                              Margin="0,0,0,8"
                              Content="Lock local settings while an owner is connected" />
                    <CheckBox x:Name="RequireApprovalForNewDevicesBox"
                              Margin="0,0,0,8"
                              Content="Ask before allowing a new device" />
                    <CheckBox x:Name="TamperProtectionEnabledBox"
                              Content="Tamper detection: block local quit during owned remote sessions" />
                </StackPanel>
            </TabItem>

            <TabItem Header="Audio">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="14">
                    <CheckBox x:Name="AllowMicrophoneAudioBox"
                              Margin="0,0,0,8"
                              Content="Allow microphone audio" />
                    <CheckBox x:Name="AllowSystemAudioBox"
                              Margin="0,0,0,8"
                              Content="Allow system audio" />
                    <Label x:Name="RemoteAudioVolumeLabel"
                           Content="Remote audio volume"
                           Target="{Binding ElementName=RemoteAudioVolumeSlider}" />
                    <Slider x:Name="RemoteAudioVolumeSlider"
                            Minimum="0"
                            Maximum="150"
                            TickFrequency="10"
                            IsSnapToTickEnabled="True"
                            Margin="0,0,0,8"
                            AutomationProperties.LabeledBy="{Binding ElementName=RemoteAudioVolumeLabel}" />
                    <Label x:Name="LocalAudioCaptureVolumeLabel"
                           Content="Local audio capture volume"
                           Target="{Binding ElementName=LocalAudioCaptureVolumeSlider}" />
                    <Slider x:Name="LocalAudioCaptureVolumeSlider"
                            Minimum="0"
                            Maximum="150"
                            TickFrequency="10"
                            IsSnapToTickEnabled="True"
                            Margin="0,0,0,8"
                            AutomationProperties.LabeledBy="{Binding ElementName=LocalAudioCaptureVolumeLabel}" />
                    <Label x:Name="DirectAudioBufferLabel"
                           Content="Direct audio buffer size"
                           Target="{Binding ElementName=DirectAudioBufferBox}" />
                    <ComboBox x:Name="DirectAudioBufferBox"
                              Width="180"
                              HorizontalAlignment="Left"
                              Margin="0,0,0,8"
                              AutomationProperties.LabeledBy="{Binding ElementName=DirectAudioBufferLabel}"
                              AutomationProperties.HelpText="Controls the capture frame size sent to the remote device. Smaller values reduce latency and may use more CPU and network capacity." />
                    <Label x:Name="WindowsAudioBufferLabel"
                           Content="Windows playback buffer size"
                           Target="{Binding ElementName=WindowsAudioBufferBox}" />
                    <ComboBox x:Name="WindowsAudioBufferBox"
                              Width="180"
                              HorizontalAlignment="Left"
                              Margin="0,0,0,8"
                              AutomationProperties.LabeledBy="{Binding ElementName=WindowsAudioBufferLabel}"
                              AutomationProperties.HelpText="Controls the local Windows playback buffer for incoming remote audio. Larger values can smooth buffering." />
                    <Label x:Name="AudioStreamingCodecLabel"
                           Content="Streaming format"
                           Target="{Binding ElementName=AudioStreamingCodecBox}" />
                    <ComboBox x:Name="AudioStreamingCodecBox"
                              Width="280"
                              HorizontalAlignment="Left"
                              Margin="0,0,0,8"
                              AutomationProperties.LabeledBy="{Binding ElementName=AudioStreamingCodecLabel}"
                              AutomationProperties.HelpText="PCM stereo 16-bit is the active native format in this build. Other formats are saved for endpoint negotiation when both sides support them.">
                        <ComboBoxItem Content="PCM stereo 16-bit, lowest processing latency" Tag="pcm_s16le" />
                        <ComboBoxItem Content="FLAC, not active in this build" Tag="flac" />
                        <ComboBoxItem Content="Ogg Opus, not active in this build" Tag="ogg_opus" />
                        <ComboBoxItem Content="MP3, not active in this build" Tag="mp3" />
                    </ComboBox>
                    <CheckBox x:Name="EnableAsioAudioDriverBox"
                              Margin="0,0,0,8"
                              Content="Use ASIO or ASIO4ALL for low-latency remote playback" />
                    <Label x:Name="AsioDriverLabel"
                           Content="ASIO driver"
                           Target="{Binding ElementName=AsioDriverBox}" />
                    <ComboBox x:Name="AsioDriverBox"
                              Margin="0,0,0,8"
                              IsEditable="False"
                              AutomationProperties.Name="ASIO driver"
                              AutomationProperties.HelpText="Choose the ASIO or ASIO4ALL driver for low-latency remote playback. Choose System default audio driver to use normal Windows audio."
                              AutomationProperties.LabeledBy="{Binding ElementName=AsioDriverLabel}">
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="{x:Type ComboBoxItem}">
                                <Setter Property="AutomationProperties.Name" Value="{Binding Content, RelativeSource={RelativeSource Self}}" />
                            </Style>
                        </ComboBox.ItemContainerStyle>
                    </ComboBox>
                    <Label x:Name="AsioLatencyLabel"
                           Content="ASIO latency"
                           Target="{Binding ElementName=AsioLatencySlider}" />
                    <Slider x:Name="AsioLatencySlider"
                            Minimum="5"
                            Maximum="200"
                            TickFrequency="5"
                            IsSnapToTickEnabled="True"
                            Margin="0,0,0,8"
                            AutomationProperties.LabeledBy="{Binding ElementName=AsioLatencyLabel}" />
                    <CheckBox x:Name="AutoMuteControlledComputerAudioBox"
                              Margin="0,0,0,8"
                              Content="Ask the controlled computer to auto-mute audio on connect" />
                    <CheckBox x:Name="MuteRemoteAudioWhenInactiveBox"
                              Margin="0,0,0,8"
                              Content="Mute remote audio when connection is minimized for local use" />
                    <Label x:Name="AutoMuteProcessesOnConnectLabel"
                           Content="Auto-muted process names"
                           Target="{Binding ElementName=AutoMuteProcessesOnConnectBox}" />
                    <TextBox x:Name="AutoMuteProcessesOnConnectBox"
                             Margin="0,0,0,8"
                             AutomationProperties.LabeledBy="{Binding ElementName=AutoMuteProcessesOnConnectLabel}" />
                    <CheckBox x:Name="UseVoiceLinkAudioFallbackBox"
                              Margin="0,0,0,8"
                              Content="Use VoiceLink audio fallback if native audio cannot connect" />
                    <Label x:Name="VoiceLinkAudioFallbackLabel"
                           Content="VoiceLink audio fallback"
                           Target="{Binding ElementName=VoiceLinkAudioFallbackBox}" />
                    <TextBox x:Name="VoiceLinkAudioFallbackBox"
                             Margin="0,0,0,8"
                             AutomationProperties.LabeledBy="{Binding ElementName=VoiceLinkAudioFallbackLabel}" />
                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Accessibility">
                <StackPanel Margin="14">
                    <CheckBox x:Name="AnnounceStatusChangesBox"
                              Margin="0,0,0,8"
                              Content="Announce connection and hosting status changes" />
                    <CheckBox x:Name="ShowActivityLogBox"
                              Margin="0,0,0,8"
                              Content="Show activity log in the main window" />
                    <CheckBox x:Name="DetailedScreenReaderMessagesBox"
                              Margin="0,0,0,8"
                              Content="Use detailed screen reader messages" />
                    <CheckBox x:Name="SoundAlertsBox"
                              Margin="0,0,0,8"
                              Content="Play sound alerts" />
                    <CheckBox x:Name="ReduceMotionBox"
                              Margin="0,0,0,8"
                              Content="Reduce motion and animation" />
                    <CheckBox x:Name="EnableDiagnosticSendingBox"
                              Margin="0,0,0,8"
                              Content="Send connection diagnostics to the OpenLink backend" />
                    <CheckBox x:Name="ShowOnlineOfflineNotificationsBox"
                              Margin="0,0,0,8"
                              Content="Show online and offline notifications" />
                    <CheckBox x:Name="ShowConnectionNotificationsBox"
                              Margin="0,0,0,8"
                              Content="Show device connection and disconnection notifications" />
                    <CheckBox x:Name="ShowElapsedConnectionTimeBox"
                              Margin="0,0,0,8"
                              Content="Show elapsed connection time in the tray" />
                    <CheckBox x:Name="AnnounceConnectionStrengthBox"
                              Margin="0,0,0,14"
                              Content="Announce connection strength before connecting" />
                    <CheckBox x:Name="EnableLocalTtsHelperBox"
                              Margin="0,0,0,8"
                              Content="Use local OpenLink TTS helper for announcements" />
                    <CheckBox x:Name="EnableBrailleDisplaySupportBox"
                              Margin="0,0,0,8"
                              Content="Send OpenLink announcements to a braille display" />
                    <CheckBox x:Name="RouteBrailleToRemoteWhenConnectedBox"
                              Margin="0,0,0,8"
                              Content="When connected, reserve the braille display for the remote machine"
                              AutomationProperties.HelpText="When keyboard and audio control are starting or active, OpenLink sends remote screen reader and VoiceOver announcements to braille and keeps local status chatter off the display." />
                    <Label x:Name="BrailleProviderLabel"
                           Content="Braille provider"
                           Target="{Binding ElementName=BrailleProviderBox}" />
                    <ComboBox x:Name="BrailleProviderBox"
                              Width="260"
                              HorizontalAlignment="Left"
                              Margin="0,0,0,8"
                              AutomationProperties.LabeledBy="{Binding ElementName=BrailleProviderLabel}"
                              AutomationProperties.HelpText="Auto tries NVDA braille first and then BRLTTY. BRLTTY uses the older Electron-compatible command bridge when available.">
                        <ComboBoxItem Content="Auto, NVDA then BRLTTY" Tag="auto" />
                        <ComboBoxItem Content="NVDA braille output" Tag="nvda" />
                        <ComboBoxItem Content="BRLTTY / BrlAPI bridge" Tag="brltty" />
                    </ComboBox>
                    <Label x:Name="BrlttyExecutablePathLabel"
                           Content="BRLTTY executable"
                           Target="{Binding ElementName=BrlttyExecutablePathBox}" />
                    <TextBox x:Name="BrlttyExecutablePathBox"
                             Margin="0,0,0,8"
                             AutomationProperties.LabeledBy="{Binding ElementName=BrlttyExecutablePathLabel}"
                             AutomationProperties.HelpText="Optional full path to brltty.exe. Leave blank to search Program Files and PATH." />
                    <Button x:Name="TestBrailleButton"
                            Width="140"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,14"
                            Content="Test braille"
                            Click="TestBrailleButton_Click"
                            AutomationProperties.Name="Test braille display output" />
                    <Label x:Name="LocalTtsVoiceLabel"
                           Content="TTS voice"
                           Target="{Binding ElementName=LocalTtsVoiceBox}" />
                    <ComboBox x:Name="LocalTtsVoiceBox"
                              Margin="0,0,0,8"
                              IsEditable="False"
                              AutomationProperties.LabeledBy="{Binding ElementName=LocalTtsVoiceLabel}" />
                    <Label x:Name="LocalTtsRateLabel"
                           Content="Speech rate"
                           Target="{Binding ElementName=LocalTtsRateSlider}" />
                    <Slider x:Name="LocalTtsRateSlider"
                            Minimum="0.5"
                            Maximum="2.0"
                            TickFrequency="0.1"
                            IsSnapToTickEnabled="True"
                            Margin="0,0,0,8"
                            AutomationProperties.LabeledBy="{Binding ElementName=LocalTtsRateLabel}" />
                    <Label x:Name="LocalTtsVolumeLabel"
                           Content="TTS volume"
                           Target="{Binding ElementName=LocalTtsVolumeSlider}" />
                    <Slider x:Name="LocalTtsVolumeSlider"
                            Minimum="0"
                            Maximum="100"
                            TickFrequency="10"
                            IsSnapToTickEnabled="True"
                            Margin="0,0,0,8"
                            AutomationProperties.LabeledBy="{Binding ElementName=LocalTtsVolumeLabel}" />
                    <Label x:Name="TtsFallbackModeLabel"
                           Content="TTS fallback"
                           Target="{Binding ElementName=TtsFallbackModeBox}" />
                    <ComboBox x:Name="TtsFallbackModeBox"
                              Width="220"
                              HorizontalAlignment="Left"
                              Margin="0,0,0,8"
                              AutomationProperties.LabeledBy="{Binding ElementName=TtsFallbackModeLabel}">
                        <ComboBoxItem Content="screen-reader" />
                        <ComboBoxItem Content="browser" />
                        <ComboBoxItem Content="silent" />
                    </ComboBox>
                    <Button x:Name="TestLocalTtsButton"
                            Width="140"
                            HorizontalAlignment="Left"
                            Content="Test voice"
                            Click="TestLocalTtsButton_Click"
                            AutomationProperties.Name="Test local TTS voice" />
                </StackPanel>
            </TabItem>

            <TabItem Header="Updates">
                <StackPanel Margin="14">
                    <CheckBox x:Name="CheckForUpdatesAutomaticallyBox"
                              Margin="0,0,0,8"
                              Content="Check for updates automatically" />
                    <CheckBox x:Name="DownloadUpdatesAutomaticallyBox"
                              Margin="0,0,0,12"
                              Content="Download and install updates automatically when safe" />
                    <Label x:Name="UpdateChannelLabel"
                           Content="Update channel"
                           Target="{Binding ElementName=UpdateChannelBox}" />
                    <ComboBox x:Name="UpdateChannelBox"
                              Width="180"
                              HorizontalAlignment="Left"
                              AutomationProperties.LabeledBy="{Binding ElementName=UpdateChannelLabel}">
                        <ComboBoxItem Content="Stable" />
                        <ComboBoxItem Content="Beta" />
                    </ComboBox>
                </StackPanel>
            </TabItem>

            <TabItem Header="Advanced">
                <Grid Margin="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Label x:Name="UpdateManifestLabel"
                           Grid.Row="0"
                           Grid.Column="0"
                           Content="Update manifest"
                           Target="{Binding ElementName=UpdateManifestBox}" />
                    <TextBox x:Name="UpdateManifestBox"
                             Grid.Row="0"
                             Grid.Column="1"
                             Margin="0,0,0,10"
                             AutomationProperties.LabeledBy="{Binding ElementName=UpdateManifestLabel}" />

                    <Label x:Name="LocalServerPortLabel"
                           Grid.Row="1"
                           Grid.Column="0"
                           Content="Local server port"
                           Target="{Binding ElementName=LocalServerPortBox}" />
                    <TextBox x:Name="LocalServerPortBox"
                             Grid.Row="1"
                             Grid.Column="1"
                             Width="120"
                             HorizontalAlignment="Left"
                             Margin="0,0,0,10"
                             AutomationProperties.LabeledBy="{Binding ElementName=LocalServerPortLabel}" />

                    <CheckBox x:Name="LocalServerEnabledBox"
                              Grid.Row="2"
                              Grid.Column="1"
                              Content="Enable local private server when entitled" />

                </Grid>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <Button x:Name="SaveButton"
                    MinWidth="92"
                    Margin="0,0,8,0"
                    Content="Save"
                    IsDefault="True"
                    Click="SaveButton_Click" />
            <Button x:Name="CancelButton"
                    MinWidth="92"
                    Content="Cancel"
                    IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
