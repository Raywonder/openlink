<Window x:Class="OpenLink.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenLink Settings"
        Height="560"
        Width="720"
        MinHeight="500"
        MinWidth="640"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Settings"
                   FontSize="24"
                   FontWeight="SemiBold"
                   Margin="0,0,0,14"
                   AutomationProperties.Name="OpenLink Settings" />

        <TabControl Grid.Row="1"
                    x:Name="SettingsTabs"
                    AutomationProperties.Name="Settings categories">
            <TabItem Header="Connection">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Label x:Name="DefaultServerLabel"
                               Grid.Row="0"
                               Grid.Column="0"
                               Content="Default server"
                               Target="{Binding ElementName=DefaultServerBox}" />
                        <ComboBox x:Name="DefaultServerBox"
                                  Grid.Row="0"
                                  Grid.Column="1"
                                  Margin="0,0,0,10"
                                  IsEditable="True"
                                  AutomationProperties.LabeledBy="{Binding ElementName=DefaultServerLabel}">
                            <ComboBoxItem Content="wss://openlink.devinecreations.net/ws" />
                            <ComboBoxItem Content="wss://openlink.raywonderis.me/ws" />
                            <ComboBoxItem Content="wss://openlink.tappedin.fm/ws" />
                            <ComboBoxItem Content="wss://ol.tappedin.fm/ws" />
                            <ComboBoxItem Content="wss://link.tappedin.fm/ws" />
                        </ComboBox>

                        <Label x:Name="SessionPrefixLabel"
                               Grid.Row="1"
                               Grid.Column="0"
                               Content="Session prefix"
                               Target="{Binding ElementName=SessionPrefixBox}" />
                        <TextBox x:Name="SessionPrefixBox"
                                 Grid.Row="1"
                                 Grid.Column="1"
                                 Margin="0,0,0,10"
                                 AutomationProperties.LabeledBy="{Binding ElementName=SessionPrefixLabel}" />

                        <CheckBox x:Name="StartHostingOnLaunchBox"
                                  Grid.Row="2"
                                  Grid.Column="1"
                                  Margin="0,0,0,8"
                                  Content="Start hosting when OpenLink opens" />
                        <CheckBox x:Name="CopyLinkWhenHostingStartsBox"
                                  Grid.Row="3"
                                  Grid.Column="1"
                                  Margin="0,0,0,8"
                                  Content="Copy hosting link when hosting starts" />
                        <CheckBox x:Name="MinimizeToTrayOnCloseBox"
                                  Grid.Row="4"
                                  Grid.Column="1"
                                  Margin="0,0,0,8"
                                  Content="Minimize to tray when closing" />
                        <CheckBox x:Name="LaunchAtLoginBox"
                                  Grid.Row="5"
                                  Grid.Column="1"
                                  Margin="0,0,0,8"
                                  Content="Launch OpenLink at Windows sign-in" />
                        <CheckBox x:Name="StartMinimizedToTrayOnLaunchBox"
                                  Grid.Row="6"
                                  Grid.Column="1"
                                  Margin="0,0,0,8"
                                  Content="Start minimized to the system tray" />
                        <CheckBox x:Name="AutoReconnectOnLaunchBox"
                                  Grid.Row="7"
                                  Grid.Column="1"
                                  Margin="0,0,0,8"
                                  Content="Auto-reconnect trusted machines when launched" />
                        <CheckBox x:Name="AutoStartInteractionOnConnectBox"
                                  Grid.Row="8"
                                  Grid.Column="1"
                                  Content="Start using a device immediately after connecting" />
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Permissions">
                <StackPanel Margin="14">
                    <CheckBox x:Name="AllowRemoteControlBox"
                              Margin="0,0,0,8"
                              Content="Allow remote control after approval" />
                    <CheckBox x:Name="AllowClipboardSyncBox"
                              Margin="0,0,0,8"
                              Content="Allow clipboard sync" />
                    <CheckBox x:Name="AllowFileTransferBox"
                              Margin="0,0,0,8"
                              Content="Allow file transfer" />
                    <CheckBox x:Name="AllowAudioBox"
                              Margin="0,0,0,8"
                              Content="Allow remote audio" />
                    <CheckBox x:Name="AllowDropInAccessBox"
                              Margin="0,0,0,8"
                              Content="Allow trusted machines to drop in" />
                    <CheckBox x:Name="AllowSwapControlBox"
                              Margin="0,0,0,8"
                              Content="Allow swap control with trusted machines" />
                    <CheckBox x:Name="AllowKeyboardCoUseBox"
                              Margin="0,0,0,8"
                              Content="Allow both keyboards while sharing control" />
                    <CheckBox x:Name="AllowMicrophoneAudioBox"
                              Margin="0,0,0,8"
                              Content="Allow microphone audio" />
                    <CheckBox x:Name="AllowSystemAudioBox"
                              Margin="0,0,0,8"
                              Content="Allow system audio" />
                    <Label x:Name="RemoteAudioVolumeLabel"
                           Content="Remote audio volume"
                           Target="{Binding ElementName=RemoteAudioVolumeSlider}" />
                    <Slider x:Name="RemoteAudioVolumeSlider"
                            Minimum="0"
                            Maximum="150"
                            TickFrequency="10"
                            IsSnapToTickEnabled="True"
                            Margin="0,0,0,8"
                            AutomationProperties.LabeledBy="{Binding ElementName=RemoteAudioVolumeLabel}" />
                    <Label x:Name="LocalAudioCaptureVolumeLabel"
                           Content="Local audio capture volume"
                           Target="{Binding ElementName=LocalAudioCaptureVolumeSlider}" />
                    <Slider x:Name="LocalAudioCaptureVolumeSlider"
                            Minimum="0"
                            Maximum="150"
                            TickFrequency="10"
                            IsSnapToTickEnabled="True"
                            Margin="0,0,0,8"
                            AutomationProperties.LabeledBy="{Binding ElementName=LocalAudioCaptureVolumeLabel}" />
                    <CheckBox x:Name="AutoMuteControlledComputerAudioBox"
                              Margin="0,0,0,8"
                              Content="Ask the controlled computer to auto-mute audio on connect" />
                    <CheckBox x:Name="MuteRemoteAudioWhenInactiveBox"
                              Margin="0,0,0,8"
                              Content="Mute remote audio when connection is minimized for local use" />
                    <Label x:Name="AutoMuteProcessesOnConnectLabel"
                           Content="Auto-muted process names"
                           Target="{Binding ElementName=AutoMuteProcessesOnConnectBox}" />
                    <TextBox x:Name="AutoMuteProcessesOnConnectBox"
                             Margin="0,0,0,8"
                             AutomationProperties.LabeledBy="{Binding ElementName=AutoMuteProcessesOnConnectLabel}" />
                    <CheckBox x:Name="UseVoiceLinkAudioFallbackBox"
                              Margin="0,0,0,8"
                              Content="Use VoiceLink audio fallback if native audio cannot connect" />
                    <CheckBox x:Name="AutoConnectTrustedMachinesBox"
                              Margin="0,0,0,8"
                              Content="Auto-connect trusted machines" />
                    <CheckBox x:Name="AllowRemoteApplicationLaunchBox"
                              Margin="0,0,0,8"
                              Content="Allow trusted machines to list, focus, quit, and relaunch apps" />
                    <CheckBox x:Name="RequireApprovalForNewDevicesBox"
                              Content="Ask before allowing a new device" />
                </StackPanel>
            </TabItem>

            <TabItem Header="Accessibility">
                <StackPanel Margin="14">
                    <CheckBox x:Name="AnnounceStatusChangesBox"
                              Margin="0,0,0,8"
                              Content="Announce connection and hosting status changes" />
                    <CheckBox x:Name="DetailedScreenReaderMessagesBox"
                              Margin="0,0,0,8"
                              Content="Use detailed screen reader messages" />
                    <CheckBox x:Name="SoundAlertsBox"
                              Margin="0,0,0,8"
                              Content="Play sound alerts" />
                    <CheckBox x:Name="ReduceMotionBox"
                              Margin="0,0,0,8"
                              Content="Reduce motion and animation" />
                    <CheckBox x:Name="ShowOnlineOfflineNotificationsBox"
                              Margin="0,0,0,8"
                              Content="Show online and offline notifications" />
                    <CheckBox x:Name="ShowConnectionNotificationsBox"
                              Margin="0,0,0,8"
                              Content="Show device connection and disconnection notifications" />
                    <CheckBox x:Name="ShowElapsedConnectionTimeBox"
                              Margin="0,0,0,8"
                              Content="Show elapsed connection time in the tray" />
                    <CheckBox x:Name="AnnounceConnectionStrengthBox"
                              Content="Announce connection strength before connecting" />
                </StackPanel>
            </TabItem>

            <TabItem Header="Updates">
                <StackPanel Margin="14">
                    <CheckBox x:Name="CheckForUpdatesAutomaticallyBox"
                              Margin="0,0,0,8"
                              Content="Check for updates automatically" />
                    <CheckBox x:Name="DownloadUpdatesAutomaticallyBox"
                              Margin="0,0,0,12"
                              Content="Download updates automatically when safe" />
                    <Label x:Name="UpdateChannelLabel"
                           Content="Update channel"
                           Target="{Binding ElementName=UpdateChannelBox}" />
                    <ComboBox x:Name="UpdateChannelBox"
                              Width="180"
                              HorizontalAlignment="Left"
                              AutomationProperties.LabeledBy="{Binding ElementName=UpdateChannelLabel}">
                        <ComboBoxItem Content="Stable" />
                        <ComboBoxItem Content="Beta" />
                    </ComboBox>
                </StackPanel>
            </TabItem>

            <TabItem Header="Advanced">
                <Grid Margin="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Label x:Name="UpdateManifestLabel"
                           Grid.Row="0"
                           Grid.Column="0"
                           Content="Update manifest"
                           Target="{Binding ElementName=UpdateManifestBox}" />
                    <TextBox x:Name="UpdateManifestBox"
                             Grid.Row="0"
                             Grid.Column="1"
                             Margin="0,0,0,10"
                             AutomationProperties.LabeledBy="{Binding ElementName=UpdateManifestLabel}" />

                    <Label x:Name="LocalServerPortLabel"
                           Grid.Row="1"
                           Grid.Column="0"
                           Content="Local server port"
                           Target="{Binding ElementName=LocalServerPortBox}" />
                    <TextBox x:Name="LocalServerPortBox"
                             Grid.Row="1"
                             Grid.Column="1"
                             Width="120"
                             HorizontalAlignment="Left"
                             Margin="0,0,0,10"
                             AutomationProperties.LabeledBy="{Binding ElementName=LocalServerPortLabel}" />

                    <CheckBox x:Name="LocalServerEnabledBox"
                              Grid.Row="2"
                              Grid.Column="1"
                              Content="Enable local private server when entitled" />

                    <Label x:Name="VoiceLinkAudioFallbackLabel"
                           Grid.Row="3"
                           Grid.Column="0"
                           Content="VoiceLink audio fallback"
                           Target="{Binding ElementName=VoiceLinkAudioFallbackBox}" />
                    <TextBox x:Name="VoiceLinkAudioFallbackBox"
                             Grid.Row="3"
                             Grid.Column="1"
                             AutomationProperties.LabeledBy="{Binding ElementName=VoiceLinkAudioFallbackLabel}" />
                </Grid>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <Button x:Name="SaveButton"
                    MinWidth="92"
                    Margin="0,0,8,0"
                    Content="Save"
                    IsDefault="True"
                    Click="SaveButton_Click" />
            <Button x:Name="CancelButton"
                    MinWidth="92"
                    Content="Cancel"
                    IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
