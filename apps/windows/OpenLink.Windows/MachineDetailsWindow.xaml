<Window x:Class="OpenLink.Windows.MachineDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Machine Details"
        Height="620"
        Width="860"
        MinHeight="520"
        MinWidth="720"
        WindowStartupLocation="CenterOwner"
        KeyDown="Window_KeyDown">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <Button DockPanel.Dock="Right"
                    MinWidth="92"
                    Content="Refresh"
                    AutomationProperties.Name="Refresh machine details and application list"
                    Click="RefreshButton_Click" />
            <StackPanel>
                <TextBlock x:Name="TitleText"
                           FontSize="22"
                           FontWeight="SemiBold"
                           AutomationProperties.Name="Machine details" />
                <TextBlock x:Name="SummaryText"
                           Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                           AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
        </DockPanel>

        <TabControl Grid.Row="1"
                    AutomationProperties.Name="Machine detail categories">
            <TabItem Header="Applications">
                <Grid Margin="0,12,0,0">
                    <ListBox x:Name="ApplicationsListBox"
                             AutomationProperties.Name="Running applications"
                             MouseDoubleClick="ApplicationsListBox_MouseDoubleClick">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="{x:Type ListBoxItem}">
                                <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleSummary}" />
                                <Setter Property="AutomationProperties.HelpText" Value="Press Shift F10 or the context menu key for app actions. Escape closes this list." />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Path}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Margin="12,0,0,0"
                                               VerticalAlignment="Center"
                                               Text="{Binding MemoryMb, StringFormat={}{0:N1} MB}" />
                                    <TextBlock Grid.Column="2"
                                               Margin="12,0,0,0"
                                               VerticalAlignment="Center"
                                               Text="{Binding Status}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Bring to Focus" Click="FocusApplication_Click" />
                                <MenuItem Header="Quit" Click="QuitApplication_Click" />
                                <MenuItem Header="Force Quit" Click="ForceQuitApplication_Click" />
                                <MenuItem Header="Quit and Reopen" Click="QuitAndReopenApplication_Click" />
                            </ContextMenu>
                        </ListBox.ContextMenu>
                    </ListBox>
                </Grid>
            </TabItem>

            <TabItem Header="Device Details">
                <ListBox x:Name="DetailsListBox"
                         Margin="0,12,0,0"
                         AutomationProperties.Name="Connected machine details">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="{x:Type ListBoxItem}">
                            <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleSummary}" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Category}" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Name}"
                                           FontWeight="SemiBold" />
                                <TextBlock Grid.Column="2"
                                           Text="{Binding Value}"
                                           TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <Button MinWidth="96"
                    Margin="0,0,8,0"
                    Content="Restart"
                    Click="RestartMachine_Click" />
            <Button MinWidth="96"
                    Margin="0,0,8,0"
                    Content="Lock"
                    Click="LockMachine_Click" />
            <Button MinWidth="96"
                    Margin="0,0,8,0"
                    Content="Log Out"
                    Click="LogoutMachine_Click" />
            <Button MinWidth="96"
                    Content="Close"
                    IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
