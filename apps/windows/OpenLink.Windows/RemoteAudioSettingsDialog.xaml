<Window x:Class="OpenLink.Windows.RemoteAudioSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Remote Audio Settings"
        Height="390"
        Width="460"
        MinHeight="340"
        MinWidth="420"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText"
                   Grid.Row="0"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Margin="0,0,0,14"
                   AutomationProperties.Name="Remote audio settings" />

        <StackPanel Grid.Row="1">
            <CheckBox x:Name="MicrophoneAudioBox"
                      Margin="0,0,0,10"
                      Content="Allow microphone audio" />
            <CheckBox x:Name="SystemAudioBox"
                      Margin="0,0,0,14"
                      Content="Allow system audio" />

            <Label x:Name="RemoteVolumeLabel"
                   Content="OpenLink remote playback volume"
                   Target="{Binding ElementName=RemoteVolumeBox}" />
            <ComboBox x:Name="RemoteVolumeBox"
                      Width="190"
                      HorizontalAlignment="Left"
                      Margin="0,0,0,10"
                      AutomationProperties.LabeledBy="{Binding ElementName=RemoteVolumeLabel}"
                      AutomationProperties.HelpText="Adjusts OpenLink playback gain only. It does not change the Windows device volume.">
                <ComboBoxItem Content="Muted" Tag="0" />
                <ComboBoxItem Content="30 percent" Tag="30" />
                <ComboBoxItem Content="50 percent" Tag="50" />
                <ComboBoxItem Content="75 percent" Tag="75" />
                <ComboBoxItem Content="100 percent" Tag="100" />
                <ComboBoxItem Content="125 percent" Tag="125" />
                <ComboBoxItem Content="150 percent" Tag="150" />
            </ComboBox>

            <Label x:Name="DirectBufferLabel"
                   Content="Direct audio buffer size"
                   Target="{Binding ElementName=DirectBufferBox}" />
            <ComboBox x:Name="DirectBufferBox"
                      Width="190"
                      HorizontalAlignment="Left"
                      Margin="0,0,0,10"
                      AutomationProperties.LabeledBy="{Binding ElementName=DirectBufferLabel}" />

            <Label x:Name="WindowsBufferLabel"
                   Content="Windows playback buffer size"
                   Target="{Binding ElementName=WindowsBufferBox}" />
            <ComboBox x:Name="WindowsBufferBox"
                      Width="190"
                      HorizontalAlignment="Left"
                      Margin="0,0,0,10"
                      AutomationProperties.LabeledBy="{Binding ElementName=WindowsBufferLabel}" />

            <Label x:Name="StreamingFormatLabel"
                   Content="Streaming format"
                   Target="{Binding ElementName=StreamingFormatBox}" />
            <ComboBox x:Name="StreamingFormatBox"
                      Width="310"
                      HorizontalAlignment="Left"
                      AutomationProperties.LabeledBy="{Binding ElementName=StreamingFormatLabel}">
                <ComboBoxItem Content="PCM stereo 16-bit, lowest latency" Tag="pcm_s16le" />
                <ComboBoxItem Content="PCM stereo 32-bit" Tag="pcm_s32le" />
                <ComboBoxItem Content="WAV PCM stereo 16-bit, 44.1 or 48 kHz" Tag="wav_pcm_s16le" />
                <ComboBoxItem Content="WAV PCM stereo 32-bit, 44.1 or 48 kHz" Tag="wav_pcm_s32le" />
                <ComboBoxItem Content="FLAC, requires FFmpeg" Tag="flac" />
                <ComboBoxItem Content="Ogg Opus, requires FFmpeg" Tag="ogg_opus" />
                <ComboBoxItem Content="MP3, requires FFmpeg" Tag="mp3" />
            </ComboBox>
        </StackPanel>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button x:Name="OkButton"
                    MinWidth="86"
                    Margin="0,0,8,0"
                    Content="OK"
                    IsDefault="True"
                    Click="OkButton_Click" />
            <Button x:Name="CancelButton"
                    MinWidth="86"
                    Content="Cancel"
                    IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
