<Window x:Class="OpenLink.Windows.WhatIsNewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="OpenLink What is New"
        Width="560"
        Height="420"
        MinWidth="480"
        MinHeight="340"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleTextBlock"
                   Grid.Row="0"
                   FontSize="18"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap"
                   automation:AutomationProperties.HeadingLevel="Level1" />

        <TextBlock Grid.Row="1"
                   Margin="0,12,0,6"
                   Text="What is new"
                   FontWeight="SemiBold"
                   automation:AutomationProperties.HeadingLevel="Level2" />

        <ListBox x:Name="ReleaseNotesListBox"
                 Grid.Row="2"
                 KeyboardNavigation.TabNavigation="None"
                 automation:AutomationProperties.Name="What is new in this OpenLink update">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding DisplayText}" TextWrapping="Wrap" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBox x:Name="ReleaseNotesTextBox"
                 Grid.Row="2"
                 IsReadOnly="True"
                 TextWrapping="Wrap"
                 AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto"
                 Visibility="Collapsed"
                 automation:AutomationProperties.Name="Update notes" />

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button x:Name="PrimaryButton"
                    Content="OK"
                    IsDefault="True"
                    MinWidth="110"
                    Margin="0,0,8,0"
                    Click="Primary_Click" />
            <Button x:Name="SecondaryButton"
                    Content="Close"
                    IsCancel="True"
                    MinWidth="90"
                    Click="Secondary_Click" />
        </StackPanel>
    </Grid>
</Window>
