OPENLINK_PUBLIC_BASE_URL=https://openlink.tappedin.fm
OPENLINK_OPENCLOUD_SHARE_ROOT=https://cloud.raywonderis.me/s/openlink-releases
OPENLINK_SIGNALING_SERVERS=wss://openlink.tappedin.fm/ws,wss://openlink.raywonderis.me/ws,wss://openlink.devinecreations.net/ws,wss://openlink.devine-creations.com/ws

# Required in production for signed status URLs and client/application link tokens.
OPENLINK_LINK_TOKEN_SECRET=replace-with-random-32-byte-secret

# Required only for server-side POST /api/link-tokens generation.
OPENLINK_LINK_ADMIN_TOKEN=replace-with-admin-generation-token

# Optional development-only fallback. Do not enable in production because
# tokens become invalid whenever the signaling service restarts.
OPENLINK_ALLOW_EPHEMERAL_LINK_SECRET=false

OPENLINK_STATUS_TOKEN_TTL_SECONDS=86400
OPENLINK_CLIENT_LINK_TOKEN_TTL_SECONDS=3600
OPENLINK_APPLICATION_TOKEN_TTL_SECONDS=86400
OPENLINK_DIAGNOSTIC_LOG_DIR=
